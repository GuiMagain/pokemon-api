# Copie para .env e preencha. Nunca versione o arquivo .env.

# Banco relacional (usado pelo CRUD)
POSTGRES_USER=pokemon
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=pokemon
# Local sem container: DATABASE_URL=sqlite:///./pokemon.db
DATABASE_URL=postgresql+psycopg://pokemon:troque-esta-senha@localhost:5432/pokemon

# PokeAPI e cache
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
CACHE_TTL=3600
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Kafka e ELK
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
LOGSTASH_HOST=localhost
LOGSTASH_PORT=5000
